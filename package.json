{
  "name": "tailors-workbench",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Pick a design and sew it at home: full-size pattern in your size, fabric to buy, and every stitch in pictures with voice.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --dir tests",
    "export-chat": "node scripts/export-chat.mjs",
    "audit": "vite --open /audit.html",
    "prompts": "vitest run --dir scripts",
    "photos": "node scripts/photos.mjs",
    "predev": "node scripts/photos.mjs",
    "prebuild": "node scripts/photos.mjs",
    "pretest": "node scripts/photos.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
